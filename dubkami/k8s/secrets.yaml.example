# Template – replace <base64-encoded-value> with actual values
# Generate with: echo -n "value" | base64
apiVersion: v1
kind: Secret
metadata:
  name: dubkami-secrets
type: Opaque
stringData:
  SECRET_KEY: "change-me-in-production"
  DATABASE_URL: "******db:5432/dubkami"
  REDIS_URL: "redis://redis:6379/0"
  CELERY_BROKER_URL: "redis://redis:6379/0"
  CELERY_RESULT_BACKEND: "redis://redis:6379/1"
  S3_ENDPOINT_URL: ""
  S3_ACCESS_KEY: ""
  S3_SECRET_KEY: ""
  S3_BUCKET_INPUT: "dubkami-input"
  S3_BUCKET_OUTPUT: "dubkami-output"
  S3_REGION: "us-east-1"
  ELEVENLABS_API_KEY: ""
  DEEPL_API_KEY: ""
  GOOGLE_TRANSLATE_KEY: ""
  WHISPER_MODEL: "medium"
